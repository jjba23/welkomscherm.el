# emacs-welkomscherm

# Copyright © 2026 Josep Bigorra <jjbigorra@gmail.com>

# SPDX-License-Identifier: MIT

# Maintainer: Josep Bigorra <jjbigorra@gmail.com>
pkgname=emacs-welkomscherm
pkgver=1.4.0
pkgrel=1
pkgdesc="Simple welcome screen and dashboard for Emacs"
arch=('any')
url="https://github.com/jjba23/welkomscherm.el"
license=('MIT')
depends=('emacs')
makedepends=('emacs')
checkdepends=('emacs')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('b909b22cf973b9e8b0b6ca498d89b5173abc74133c544c9617bebf3725917a5e')

build() {
  cd "$srcdir/welkomscherm.el-$pkgver"

  emacs -Q --batch -f batch-byte-compile welkomscherm.el
}

check() {
  cd "$srcdir/welkomscherm.el-$pkgver"

  emacs -Q --batch -L . -L test -l test/welkomscherm-test.el -f ert-run-tests-batch-and-exit
}

package() {
  cd "$srcdir/welkomscherm.el-$pkgver"

  install -Dm644 welkomscherm.el "$pkgdir/usr/share/emacs/site-lisp/welkomscherm.el"
  install -Dm644 welkomscherm.elc "$pkgdir/usr/share/emacs/site-lisp/welkomscherm.elc"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.org "$pkgdir/usr/share/doc/$pkgname/README.org"
  install -Dm644 NEWS.org "$pkgdir/usr/share/doc/$pkgname/NEWS.org"
}
