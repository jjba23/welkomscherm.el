<services>
  <service name="obs_scm" mode="manual">
    <param name="scm">git</param>
    <param name="url">https://codeberg.org/jjba23/welkomscherm.el.git</param>
    <param name="revision">trunk</param>
    <param name="filename">welkomscherm.el</param>
    <param name="match-tag">v*</param>
    <param name="versionformat">@PARENT_TAG@</param>
    <param name="versionrewrite-pattern">v(.*)</param>
    <param name="versionrewrite-replacement">\1</param>
    <param name="extract">packaging/opensuse/emacs-welkomscherm.spec</param>
    <param name="changesgenerate">enable</param>
  </service>

  <service name="tar" mode="buildtime"/>

  <service name="recompress" mode="buildtime">
    <param name="compression">gz</param>
    <param name="file">*.tar</param>
  </service>

  <service name="set_version" mode="buildtime"/>
</services>
