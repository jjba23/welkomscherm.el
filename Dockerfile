# syntax=docker/dockerfile:1.7

# welkomscherm-el
#
# Generated by gen_containers.py; keep in step with packaging/.

FROM opensuse/tumbleweed:latest AS builder

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

WORKDIR /src

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends emacs; \
    zypper clean --all

COPY welkomscherm.el ./

RUN set -eu; \
    emacs -Q --batch -f batch-byte-compile "welkomscherm.el"

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------

FROM opensuse/tumbleweed:latest AS runtime

ARG VERSION=dev

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="welkomscherm-el" \
      org.opencontainers.image.description="Simple welcome screen and dashboard for Emacs" \
      org.opencontainers.image.url="https://codeberg.org/jjba23/welkomscherm.el" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.version="${VERSION}"

RUN --mount=type=cache,target=/var/cache/zypp \
    set -eu; \
    zypper --non-interactive refresh; \
    zypper --non-interactive install --no-recommends emacs; \
    zypper clean --all

COPY --from=builder /src/welkomscherm.el /usr/share/emacs/site-lisp/welkomscherm.el
COPY --from=builder /src/welkomscherm.elc /usr/share/emacs/site-lisp/welkomscherm.elc

ENTRYPOINT ["emacs"]
CMD ["-nw"]
